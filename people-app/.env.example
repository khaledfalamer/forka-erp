# Copy to .env for local overrides. These defaults are for a local machine only; never use them on a server.
# Production values live in the cloud secrets manager, never in the repository.
NODE_ENV=development
PORT=8080
PEOPLE_DB_NAME=forka_people
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
OWNER_DATABASE_URL=postgres://people_owner:owner_dev_only@localhost:5432/forka_people
DATABASE_URL=postgres://people_app:app_dev_only@localhost:5432/forka_people
SESSION_SECRET=dev-only-session-secret-change-me-0123456789
